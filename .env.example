# --- Cách 1: URL API đầy đủ (khuyến nghị, ghi đè mọi biến bên dưới) ---
VITE_API_URL=http://localhost:4000/api/version/v1

# --- Cách 2: Ghép từ từng phần (dùng khi không set VITE_API_URL) ---
# VITE_API_BASE_URL=http://localhost
# VITE_API_PORT=:4000
# VITE_API_PATH=/api
# VITE_API_VERSION=/version
# VITE_API_V1=/v1

# Socket.IO — để trống = origin của API
# VITE_SOCKET_URL=http://localhost:4000

# Đồng bộ Swagger (npm run sync:api) — mặc định http://localhost:4000/docs.json
# HRM_METAL_SWAGGER_URL=http://localhost:4000/docs.json
